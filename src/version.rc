/* Windows version resource of the Makefile release build (windres) and the Visual Studio project (rc). */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SKM_VERSION_MAJOR, SKM_VERSION_MINOR, SKM_VERSION_PATCH, 0
PRODUCTVERSION SKM_VERSION_MAJOR, SKM_VERSION_MINOR, SKM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Niko Ruohonen"
            VALUE "FileDescription", "Split k-means clustering experiments"
            VALUE "FileVersion", SKM_VERSION
            VALUE "InternalName", "split_kmeans"
            VALUE "LegalCopyright", "Copyright (C) 2025 Niko Ruohonen and contributors, AGPL-3.0-only"
            VALUE "OriginalFilename", "split_kmeans.exe"
            VALUE "ProductName", "Split_kMeans"
            VALUE "ProductVersion", SKM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
