  <!-- Writes IntDir\build_info.h only when its text changes, so its users recompile after a commit -->
  <Target Name="SkmBuildInfo" BeforeTargets="ClCompile">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(SolutionDir)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SkmCommit" />
      <Output TaskParameter="ExitCode" PropertyName="SkmCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(SolutionDir)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SkmStatus" />
      <Output TaskParameter="ExitCode" PropertyName="SkmStatusExit" />
    </Exec>
    <!-- Files in src that git does not track yet are compiled too (src\*.c), so they also make the build dirty -->
    <Exec Command="git ls-files --others --exclude-standard -- src" WorkingDirectory="$(SolutionDir)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SkmUntracked" />
    </Exec>
    <PropertyGroup>
      <SkmCommit Condition="'$(SkmCommitExit)' != '0' Or '$(SkmCommit)' == ''">unknown</SkmCommit>
      <SkmDirty Condition="'$(SkmStatusExit)' == '0' And ('$(SkmStatus)' != '' Or '$(SkmUntracked)' != '')">-dirty</SkmDirty>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)build_info.h" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="#define SKM_GIT_COMMIT &quot;$(SkmCommit)$(SkmDirty)&quot;;#define SKM_BUILD_FLAGS &quot;Visual Studio project, $(Configuration)|$(Platform), toolset $(PlatformToolset)&quot;" />
  </Target>
