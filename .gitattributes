* text=auto

# Visual Studio and PowerShell files keep CRLF on every OS
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
# Checked with `sha256sum -c`, which needs LF line endings
tests/realdata-sha256.txt text eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.pptx binary

# Left out of shared code archives (git archive, GitHub ZIP); they stay in the repository
/.github export-ignore
/docs export-ignore
/results export-ignore
/university export-ignore
